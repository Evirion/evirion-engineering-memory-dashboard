__pycache__/
*.py[cod]
.DS_Store
# Locally generated tool output and key material. `.local` is also excluded
# from the authority walk, so nothing here is ever a tracked repository file.
.local/
.venv/
.env
.env.*
!.env.example
dist/
node_modules/
.next/
# Regenerated by Next.js on every dev run and every build, and it points at a
# different generated types directory in each, so tracking it makes the working
# tree dirty depending on which command ran last.
next-env.d.ts
coverage/
test-results/
playwright-report/
