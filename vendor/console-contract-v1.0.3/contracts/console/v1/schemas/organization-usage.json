{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evirion:console:v1:schema:organization-usage",
  "title": "Organization operational usage",
  "description": "Operational usage for one closed UTC date range. `basis` states in the document itself that these are operational figures and not an invoice. The whole surface is gated on organization.usage.read and refused rather than partially projected, so no field here is ever omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "basis",
    "period",
    "activeRepositories",
    "historicalPullRequestsProcessed",
    "livePullRequestsProcessedInPeriod",
    "acceptedKnowledgeObjects",
    "cost"
  ],
  "properties": {
    "organizationId": {
      "type": "string",
      "format": "uuid",
      "x-evirion-backend-projection": "core.organizations.id",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "basis": {
      "type": "string",
      "const": "OPERATIONAL_NOT_INVOICE",
      "description": "A closed statement rather than an enum: these figures are never a billing document, and no second basis exists for the backend to report.",
      "x-evirion-backend-projection": "api.get_organization_usage.basis",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "start",
        "end"
      ],
      "description": "The exact window every figure below is measured over. Both ends are inclusive UTC dates and default to the current UTC month.",
      "properties": {
        "timezone": {
          "type": "string",
          "const": "UTC",
          "x-evirion-backend-projection": "api.get_organization_usage.timezone",
          "x-evirion-sensitivity": "customer-safe-summary"
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "A calendar date rather than an instant, published as a pattern because the Console's reviewed format set has no `date`.",
          "x-evirion-backend-projection": "api.get_organization_usage.period_start",
          "x-evirion-sensitivity": "customer-safe-summary"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Inclusive, and never before `start`, which the routine refuses.",
          "x-evirion-backend-projection": "api.get_organization_usage.period_end",
          "x-evirion-sensitivity": "customer-safe-summary"
        }
      },
      "x-evirion-backend-projection": "api.get_organization_usage.period",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "activeRepositories": {
      "type": "integer",
      "minimum": 0,
      "description": "Current entitled repositories, not a figure measured over the period.",
      "x-evirion-backend-projection": "core.repository_entitlements.status",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "historicalPullRequestsProcessed": {
      "type": "integer",
      "minimum": 0,
      "description": "Distinct pull requests processed by historical import, over all time rather than over the period, because deactivation never reduces historical usage.",
      "x-evirion-backend-projection": "api.get_organization_usage.historical_pull_requests",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "livePullRequestsProcessedInPeriod": {
      "type": "integer",
      "minimum": 0,
      "description": "Distinct pull requests processed from a GitHub webhook whose job was created inside the period.",
      "x-evirion-backend-projection": "api.get_organization_usage.live_pull_requests",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "acceptedKnowledgeObjects": {
      "type": "integer",
      "minimum": 0,
      "description": "Knowledge Objects of an accepted admission created inside the period.",
      "x-evirion-backend-projection": "api.get_organization_usage.accepted_knowledge_objects",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "measuredUsd",
        "reservedUsd",
        "unresolvedUsd"
      ],
      "description": "An amount and its completeness, always together. Cost stays attributed to the period in which the execution first became terminal, never to the period in which it was later settled.",
      "properties": {
        "completeness": {
          "type": "string",
          "enum": [
            "RESERVED",
            "MEASURED",
            "UNRESOLVED",
            "NOT_APPLICABLE",
            "UNSUPPORTED_SERVER_RESPONSE"
          ],
          "description": "Derived from the stored accounting status of the cohort, so an unresolved cost can never be rendered as a measured zero.",
          "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE",
          "x-evirion-backend-projection": "core.extraction_jobs.model_cost_accounting_status",
          "x-evirion-sensitivity": "customer-safe-summary"
        },
        "measuredUsd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{6}$",
          "x-evirion-backend-projection": "core.extraction_jobs.model_cost_accounted_usd",
          "x-evirion-sensitivity": "customer-safe-summary"
        },
        "reservedUsd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{6}$",
          "x-evirion-backend-projection": "core.extraction_jobs.model_cost_reservation_usd",
          "x-evirion-sensitivity": "customer-safe-summary"
        },
        "unresolvedUsd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{6}$",
          "x-evirion-backend-projection": "core.extraction_jobs.model_cost_unresolved_usd",
          "x-evirion-sensitivity": "customer-safe-summary"
        }
      },
      "x-evirion-backend-projection": "api.get_organization_usage.cost",
      "x-evirion-sensitivity": "customer-safe-summary"
    }
  },
  "examples": [
    {
      "organizationId": "00000000-0000-4000-8000-000000000102",
      "basis": "OPERATIONAL_NOT_INVOICE",
      "period": {
        "timezone": "UTC",
        "start": "2026-09-01",
        "end": "2026-09-03"
      },
      "activeRepositories": 2,
      "historicalPullRequestsProcessed": 0,
      "livePullRequestsProcessedInPeriod": 3,
      "acceptedKnowledgeObjects": 1,
      "cost": {
        "completeness": "MEASURED",
        "measuredUsd": "0.450000",
        "reservedUsd": "0.000000",
        "unresolvedUsd": "0.000000"
      }
    }
  ]
}
