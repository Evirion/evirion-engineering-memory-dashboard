{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evirion:console:v1:schema:knowledge-lifecycle-state",
  "title": "Effective lifecycle state",
  "description": "The effective lifecycle state, its optimistic version, whether the object is in the active projection, its supersession edges in both directions, and the identifier of any open correction request. The same document is embedded in the Knowledge Object detail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledgeObjectId",
    "reviewSequence",
    "decision",
    "lifecycleVersion",
    "lifecycleState",
    "inActiveProjection",
    "allowedLifecycleActions",
    "supersededBy",
    "supersedes",
    "openCorrectionRequestId"
  ],
  "properties": {
    "knowledgeObjectId": {
      "type": "string",
      "format": "uuid",
      "x-evirion-backend-projection": "core.knowledge_objects.id",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "reviewSequence": {
      "type": "integer",
      "minimum": 0,
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.review_sequence",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "decision": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "EDITED",
        "USER_REJECTED",
        "UNSUPPORTED_SERVER_RESPONSE"
      ],
      "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.decision",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "lifecycleVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "Incremented by exactly one on every lifecycle append. Zero means UNRESOLVED.",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.lifecycle_version",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "UNRESOLVED",
        "ACTIVE",
        "SUPERSEDED",
        "WITHDRAWN",
        "UNSUPPORTED_SERVER_RESPONSE"
      ],
      "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.lifecycle_state",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "inActiveProjection": {
      "type": "boolean",
      "description": "A backend fact, true exactly when the effective state is ACTIVE. The interface never derives trusted retrieval membership itself.",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.in_active_projection",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "allowedLifecycleActions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "MARK_ACTIVE",
          "MARK_SUPERSEDED",
          "REQUEST_CORRECTION",
          "UNSUPPORTED_SERVER_RESPONSE"
        ],
        "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE"
      },
      "description": "Ascending by action name. It never carries an operator-only action.",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.allowed_lifecycle_actions",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "supersededBy": {
      "type": "array",
      "items": {
        "$ref": "knowledge-relation-edge.json"
      },
      "description": "Edges whose other end is the newer object replacing this one. The relation direction is always new supersedes old.",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.superseded_by",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "knowledge-relation-edge.json"
      },
      "description": "Edges whose other end is an older object this one replaces.",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.supersedes",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "openCorrectionRequestId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uuid"
        }
      ],
      "description": "Null while no correction request is REQUESTED, EXECUTING or FAILED. The key is always present.",
      "x-evirion-backend-projection": "api.get_knowledge_lifecycle_state.open_correction_request_id",
      "x-evirion-sensitivity": "customer-safe-summary"
    }
  },
  "examples": [
    {
      "knowledgeObjectId": "00000000-0000-4000-8000-000000000401",
      "reviewSequence": 0,
      "decision": "PENDING",
      "lifecycleVersion": 0,
      "lifecycleState": "UNRESOLVED",
      "inActiveProjection": false,
      "allowedLifecycleActions": [],
      "supersededBy": [],
      "supersedes": [],
      "openCorrectionRequestId": null
    },
    {
      "knowledgeObjectId": "00000000-0000-4000-8000-000000000402",
      "reviewSequence": 1,
      "decision": "APPROVED",
      "lifecycleVersion": 2,
      "lifecycleState": "SUPERSEDED",
      "inActiveProjection": false,
      "allowedLifecycleActions": [
        "REQUEST_CORRECTION"
      ],
      "supersededBy": [
        {
          "knowledgeRelationId": "00000000-0000-4000-8000-000000000431",
          "knowledgeObjectId": "00000000-0000-4000-8000-000000000403",
          "relationVersion": 1,
          "relationState": "ACTIVE"
        }
      ],
      "supersedes": [],
      "openCorrectionRequestId": "00000000-0000-4000-8000-000000000441"
    }
  ]
}
