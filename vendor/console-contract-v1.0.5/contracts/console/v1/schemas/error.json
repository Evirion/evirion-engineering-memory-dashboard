{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evirion:console:v1:schema:error",
  "title": "API error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "error"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0",
      "x-evirion-backend-projection": "console-api.response-envelope",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "x-evirion-backend-projection": "console-api.request-context",
      "x-evirion-sensitivity": "admin-operational"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTHENTICATION_REQUIRED",
            "ORGANIZATION_MEMBERSHIP_REQUIRED",
            "CAPABILITY_REQUIRED",
            "REAUTHENTICATION_REQUIRED",
            "RESOURCE_NOT_FOUND",
            "IDEMPOTENCY_KEY_REUSED",
            "VERSION_CONFLICT",
            "ORGANIZATION_LIMIT_NOT_PROVISIONED",
            "REPOSITORY_NOT_ENTITLED",
            "MODEL_PROFILE_NOT_OFFERED",
            "REPOSITORY_LIMIT_REACHED",
            "REPOSITORY_REPLACEMENT_REQUIRES_OPERATOR",
            "REPOSITORY_ACCESS_CHANGED",
            "ENTITLEMENT_GENERATION_STALE",
            "BACKFILL_NOT_APPROVABLE",
            "NEW_MODEL_CALL_NOT_AUTHORIZED",
            "PAID_OPERATION_NOT_AUTHORIZED",
            "PROVIDER_OUTCOME_UNKNOWN",
            "REVIEW_VERSION_CONFLICT",
            "LIFECYCLE_VERSION_CONFLICT",
            "SUPERSESSION_INVALID",
            "SUPERSESSION_TRAVERSAL_LIMIT",
            "KNOWLEDGE_ACTION_NOT_ALLOWED",
            "INVITATION_STATE_CONFLICT",
            "ORGANIZATION_CONTROL_CONFLICT",
            "GITHUB_SYNC_INCOMPLETE",
            "REPOSITORY_IMPORT_FILTERS_INVALID",
            "REPOSITORY_IMPORT_JOB_NOT_RETRYABLE",
            "REPOSITORY_IMPORT_NOT_CANCELLABLE",
            "REPOSITORY_IMPORT_NOT_RESUMABLE",
            "REPOSITORY_IMPORT_NOT_PAUSABLE",
            "REPOSITORY_IMPORT_NOT_APPROVABLE",
            "REPOSITORY_IMPORT_ALREADY_ACTIVE",
            "REPOSITORY_IMPORT_NOT_FOUND",
            "INTERNAL_ERROR",
            "RATE_LIMITED",
            "REQUEST_INVALID",
            "REQUEST_TOO_LARGE",
            "DEPENDENCY_UNAVAILABLE",
            "UNSUPPORTED_SERVER_RESPONSE"
          ],
          "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE",
          "x-evirion-backend-projection": "console-api.error-mapper",
          "x-evirion-sensitivity": "admin-operational"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-evirion-backend-projection": "console-api.error-mapper",
          "x-evirion-sensitivity": "admin-operational"
        },
        "retryable": {
          "type": "boolean",
          "x-evirion-backend-projection": "console-api.error-mapper",
          "x-evirion-sensitivity": "admin-operational"
        },
        "currentVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "The current one-based resource version. Which of the two detail fields a conflict carries is decided by the shape of the optimistic token, not by the error code, and a client reads whichever is present.",
          "x-evirion-backend-projection": "owning-operation-projection",
          "x-evirion-sensitivity": "customer-safe-summary"
        },
        "currentSequence": {
          "type": "integer",
          "minimum": 0,
          "description": "The current zero-based sequence token. Zero is legitimate: review sequence zero means PENDING, lifecycle version zero means UNRESOLVED, and relation version zero means no relation state event has been appended, so this is deliberately not the currentVersion shape. A VERSION_CONFLICT raised on a relation version carries this field rather than currentVersion for that reason.",
          "x-evirion-backend-projection": "owning-operation-projection",
          "x-evirion-sensitivity": "customer-safe-summary"
        }
      },
      "x-evirion-backend-projection": "console-api.error-mapper",
      "x-evirion-sensitivity": "admin-operational"
    }
  },
  "examples": [
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000001",
      "error": {
        "code": "AUTHENTICATION_REQUIRED",
        "message": "Authentication is required.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000002",
      "error": {
        "code": "ORGANIZATION_MEMBERSHIP_REQUIRED",
        "message": "Active organization membership is required.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000003",
      "error": {
        "code": "CAPABILITY_REQUIRED",
        "message": "The required capability is unavailable.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-00000000002c",
      "error": {
        "code": "REAUTHENTICATION_REQUIRED",
        "message": "This action requires a fresher authentication.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000004",
      "error": {
        "code": "RESOURCE_NOT_FOUND",
        "message": "The requested resource was not found.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000005",
      "error": {
        "code": "IDEMPOTENCY_KEY_REUSED",
        "message": "The idempotency key was used for a different request.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000006",
      "error": {
        "code": "VERSION_CONFLICT",
        "message": "The resource version changed.",
        "retryable": false,
        "currentVersion": 2
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000007",
      "error": {
        "code": "ORGANIZATION_LIMIT_NOT_PROVISIONED",
        "message": "The organization limit is not provisioned.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000008",
      "error": {
        "code": "REPOSITORY_NOT_ENTITLED",
