    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000018",
      "error": {
        "code": "LIFECYCLE_VERSION_CONFLICT",
        "message": "The lifecycle version changed.",
        "retryable": false,
        "currentSequence": 0
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-00000000002d",
      "error": {
        "code": "VERSION_CONFLICT",
