      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000012",
      "error": {
        "code": "ENTITLEMENT_GENERATION_STALE",
        "message": "The entitlement generation is stale.",
        "retryable": false,
        "currentVersion": 2
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000013",
      "error": {
        "code": "BACKFILL_NOT_APPROVABLE",
        "message": "The import is not approvable.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000014",
      "error": {
        "code": "NEW_MODEL_CALL_NOT_AUTHORIZED",
        "message": "A new model call is not authorized.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000015",
      "error": {
        "code": "PAID_OPERATION_NOT_AUTHORIZED",
        "message": "The paid operation is not authorized.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000016",
      "error": {
        "code": "PROVIDER_OUTCOME_UNKNOWN",
        "message": "The provider outcome is unknown.",
        "retryable": false
      }
    },
    {
      "contractVersion": "1.0",
      "requestId": "00000000-0000-4000-8000-000000000017",
      "error": {
        "code": "REVIEW_VERSION_CONFLICT",
        "message": "The review sequence changed.",
        "retryable": false,
