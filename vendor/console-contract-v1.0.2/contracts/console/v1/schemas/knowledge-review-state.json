{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evirion:console:v1:schema:knowledge-review-state",
  "title": "Effective review state",
  "description": "The effective review decision, both optimistic tokens, and the actions the state allows. `allowedActions` is the authority for what the interface may offer; a client never infers it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledgeObjectId",
    "reviewSequence",
    "decision",
    "lifecycleVersion",
    "lifecycleState",
    "allowedActions",
    "latestReview"
  ],
  "properties": {
    "knowledgeObjectId": {
      "type": "string",
      "format": "uuid",
      "x-evirion-backend-projection": "core.knowledge_objects.id",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "reviewSequence": {
      "type": "integer",
      "minimum": 0,
      "description": "The optimistic review token to echo back. Zero is legitimate and means PENDING, so this is deliberately not the `expectedVersion` shape used by resource-versioned mutations.",
      "x-evirion-backend-projection": "api.get_knowledge_review_state.review_sequence",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "decision": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "EDITED",
        "USER_REJECTED",
        "UNSUPPORTED_SERVER_RESPONSE"
      ],
      "description": "PENDING exists only in the projection and is never stored.",
      "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE",
      "x-evirion-backend-projection": "api.get_knowledge_review_state.decision",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "lifecycleVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "The optimistic lifecycle token to echo back. Zero means UNRESOLVED.",
      "x-evirion-backend-projection": "api.get_knowledge_review_state.lifecycle_version",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "UNRESOLVED",
        "ACTIVE",
        "SUPERSEDED",
        "WITHDRAWN",
        "UNSUPPORTED_SERVER_RESPONSE"
      ],
      "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE",
      "x-evirion-backend-projection": "api.get_knowledge_review_state.lifecycle_state",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "allowedActions": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "APPROVE",
          "EDIT",
          "USER_REJECT",
          "REVERT_TO_ORIGINAL_AND_APPROVE",
          "UNSUPPORTED_SERVER_RESPONSE"
        ],
        "x-evirion-unsupported-value": "UNSUPPORTED_SERVER_RESPONSE"
      },
      "description": "Ascending by action name, and empty when the state allows none.",
      "x-evirion-backend-projection": "api.get_knowledge_review_state.allowed_actions",
      "x-evirion-sensitivity": "customer-safe-summary"
    },
    "latestReview": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "knowledge-review.json"
        }
      ],
      "description": "Null while the object is PENDING. The projection does not strip its outer nulls, so the key is always present.",
      "x-evirion-backend-projection": "api.get_knowledge_review_state.latest_review",
      "x-evirion-sensitivity": "customer-safe-detail"
    }
  },
  "examples": [
    {
      "knowledgeObjectId": "00000000-0000-4000-8000-000000000401",
      "reviewSequence": 0,
      "decision": "PENDING",
      "lifecycleVersion": 0,
      "lifecycleState": "UNRESOLVED",
      "allowedActions": [
        "APPROVE",
        "EDIT",
        "USER_REJECT"
      ],
      "latestReview": null
    },
    {
      "knowledgeObjectId": "00000000-0000-4000-8000-000000000401",
      "reviewSequence": 1,
      "decision": "APPROVED",
      "lifecycleVersion": 0,
      "lifecycleState": "UNRESOLVED",
      "allowedActions": [],
      "latestReview": {
        "reviewId": "00000000-0000-4000-8000-000000000411",
        "reviewSequence": 1,
        "action": "APPROVE",
        "decision": "APPROVED",
        "reviewerUserId": "00000000-0000-4000-8000-000000000201",
        "reviewerRole": "reviewer",
        "originalPayloadSha256": "3d2f1c0b9a8776655443322110ffeeddccbbaa99887766554433221100ffeedd",
        "acknowledgedEvidenceIds": [],
        "observedLifecycleVersion": 0,
        "observedLifecycleState": "UNRESOLVED",
        "recordedAt": "2026-09-02T18:33:41.123456Z"
      }
    }
  ]
}
