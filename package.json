{
  "name": "evirion-engineering-memory-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src tests tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "tls:generate": "node tools/local-tls/generate-certificate.mjs",
    "tls:serve": "node tools/local-tls/edge.mjs",
    "security:sast": "uv run --frozen --project tools/security semgrep scan --config tools/security/semgrep.yml --error",
    "security:secrets": "bash scripts/security/verify-toolchain.sh gitleaks-scan",
    "verify:focused": "node tools/verify/run.mjs focused",
    "verify:affected": "node tools/verify/run.mjs affected",
    "verify": "node tools/verify/run.mjs full"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
