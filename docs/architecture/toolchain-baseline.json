    "sigstore": "https://github.com/sigstore/cosign/releases"
  },
  "runtime": {
    "node": "24.20.0",
    "nodeReleaseLine": "Krypton LTS"
  },
  "schemaVersion": "1.0",
  "serverBrowserBoundary": {
    "browserForbidden": [
      "Supabase access token",
      "Supabase refresh token",
      "service_role key",
      "database DSN",
      "GitHub App private key",
      "provider API key",
      "raw source envelope",
      "raw model response"
