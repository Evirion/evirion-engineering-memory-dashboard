    "cookieAttributes": "__Host- prefix; HttpOnly; Secure; SameSite=Lax; Path=/; no Domain",
    "sessionStorage": "server-only request-local cookie adapter",
    "supabaseAuthMethods": [
      "getClaims",
      "getUser"
